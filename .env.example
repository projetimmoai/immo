# Copier ce fichier en ".env" et renseigner les vraies valeurs (jamais commiter .env).

# URL du projet Supabase (Project Settings > API)
SUPABASE_URL=

# Clé service_role Supabase (Project Settings > API) — accès total, backend uniquement, ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# Contenu JSON complet de la clé du compte de service Google (Drive API activée,
# et le dossier racine "NE PAS MODIFIER - fichiers" doit lui être partagé).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Id du dossier Drive racine "NE PAS MODIFIER - fichiers" (dans son URL Drive :
# https://drive.google.com/drive/folders/<ID>).
DRIVE_ROOT_FOLDER_ID=
