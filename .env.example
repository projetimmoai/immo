# Copier ce fichier en ".env" et renseigner les vraies valeurs (jamais commiter .env).

# URL du projet Supabase (Project Settings > API)
SUPABASE_URL=

# Clé service_role Supabase (Project Settings > API) — accès total, backend uniquement, ne jamais exposer côté client.
# Utilisée à la fois pour l'API REST (internal/repository) et l'API Storage (internal/storage) : même projet, mêmes identifiants.
SUPABASE_SERVICE_ROLE_KEY=

# Contenu JSON complet du client OAuth2 "Application de bureau" (Google Cloud
# Console > API et services > Identifiants), avec l'API Gmail activée.
GOOGLE_OAUTH_CLIENT_JSON=

# Jeton OAuth2 (incluant le refresh_token) pour le compte Gmail surveillé,
# obtenu une fois pour toutes via `go run ./cmd/gmail-auth`.
GOOGLE_OAUTH_TOKEN_JSON=

# Clé API Anthropic (console.anthropic.com), utilisée pour la classification
# des e-mails (internal/claudeapi).
ANTHROPIC_API_KEY=
